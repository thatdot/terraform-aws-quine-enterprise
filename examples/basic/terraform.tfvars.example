# -----------------------------------------------------------------------------
# Example Configuration for Basic Deployment
# -----------------------------------------------------------------------------
# Copy this file to terraform.tfvars and customize for your environment.
# Lines starting with # are comments.
# -----------------------------------------------------------------------------

# AWS Configuration
aws_region = "us-west-2"

# Container Configuration (Required)
container_image = "your-registry/quine-enterprise:latest"

# Quine Enterprise Configuration
license_key = ""  # Required - your Quine Enterprise license key
