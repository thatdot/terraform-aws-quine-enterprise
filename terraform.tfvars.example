# AWS Configuration
aws_region   = "us-west-2"
project_name = "quine-enterprise"
environment  = "dev"

# ECS Configuration
cluster_name     = "quine-enterprise-cluster"
service_name     = "quine-enterprise-service"
container_name   = "quine"
container_image  = "your-registry/quine-enterprise:latest"  # Required - provide your Quine Enterprise image
container_port   = 8080
container_cpu    = 2048
container_memory = 4096
desired_count    = 1

# Health Check
health_check_path = "/api/v1/liveness"
